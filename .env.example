
# ==============================================================================
# OpenPiar — Variables de Entorno para Docker Compose
# Copia este archivo como `.env` en la raíz del proyecto.
# NUNCA subas el archivo `.env` al repositorio (ya está en .gitignore).
# ==============================================================================
# INSTRUCCIONES RÁPIDAS:
# 1. Copia este archivo:
#    cp .env.example .env
# 2. Configura los 2 campos OBLIGATORIOS:
#    - DB_PASSWORD: una contraseña para la base de datos interna.
#    - SECRET_KEY: una clave JWT (genera una con: openssl rand -hex 32)
# 3. Inicia con Docker:
#    docker compose up -d --build
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL interno gestionado por Docker)
# ------------------------------------------------------------------------------
# Docker Compose asigna automáticamente el host 'db' y el puerto 5432 internamente.
DB_USER=openpiar_user
DB_PASSWORD=
DB_NAME=openpiar_db

# ------------------------------------------------------------------------------
# 2. SEGURIDAD — JWT (OBLIGATORIA)
# ------------------------------------------------------------------------------
# Genera una clave segura ejecutando en terminal: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# 3. SETUP WIZARD — TOKEN DE INSTALACIÓN (OBLIGATORIO EN INSTALACIONES NUEVAS)
# ------------------------------------------------------------------------------
# Protege el asistente de configuración inicial. Genera uno con:
#   openssl rand -hex 32
# El primer administrador deberá introducirlo en el asistente. Una vez que el
# setup se completa, el token queda invalidado permanentemente y puede
# eliminarse de este archivo.
BOOTSTRAP_TOKEN=

# ------------------------------------------------------------------------------
# 4. PUERTO DEL FRONTEND (Servidor Web Nginx)
# ------------------------------------------------------------------------------
# Puerto en el servidor local donde se expondrá la aplicación (http://IP_SERVIDOR:PUERTO)
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 5. APLICACIÓN Y ACCESO LOCAL
# ------------------------------------------------------------------------------
APP_ENV=production
# En producción cambiar a False para no exponer los docs de Swagger
SHOW_DOCS=False

# Orígenes permitidos para CORS (separados por coma).
# En un servidor local puedes agregar la IP de la red: http://localhost,http://192.168.1.50
CORS_ORIGINS=http://localhost

# ------------------------------------------------------------------------------
# 6. INTELIGENCIA ARTIFICIAL — Google Gemini API (OPCIONAL)
# ------------------------------------------------------------------------------
# Requerido ÚNICAMENTE si el servidor tiene salida a internet y se desea activar
# el asistente de sugerencias de ajustes razonables con IA.
# Si el servidor trabaja 100% offline o no deseas usar IA, déjalo vacío.
# Obtén tu clave en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
