# OpenPiar — variables para Docker Compose
# Copia este archivo como .env y completalo. Es el ÚNICO archivo requerido para Docker.
# Para desarrollo local sin Docker usa backend/.env (ver backend/.env.example).

# ------------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
DB_USER=openpiar_user
DB_PASSWORD=
DB_NAME=openpiar_db

# ------------------------------------------------------------------------------
# SEGURIDAD — JWT (obligatoria)
# Genera una clave con: openssl rand -hex 32
# ------------------------------------------------------------------------------
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ------------------------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL — Google Gemini (opcional)
# Si la dejas vacía, configura la clave desde el asistente de configuración:
# se guardará en la base de datos y tendrá prioridad sobre esta variable.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------------------------
APP_ENV=production
# En producción deja False para no exponer los docs de Swagger
SHOW_DOCS=False
CORS_ORIGINS=http://localhost

# ------------------------------------------------------------------------------
# FRONTEND
# Puerto donde se expone la interfaz (default: 80)
# ------------------------------------------------------------------------------
# FRONTEND_PORT=80
