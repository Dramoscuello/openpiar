# ==============================================================================
# OpenPiar — Variables de Entorno
# Copia este archivo como `.env` y rellena tus credenciales reales.
# NUNCA subas el archivo `.env` al repositorio (ya está en .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=openpiar_user
DB_PASSWORD=
DB_NAME=openpiar_db

# URL ensamblada automáticamente desde las variables anteriores.
# Puedes también sobreescribirla directamente:
# DATABASE_URL=postgresql+asyncpg://openpiar_user:password@localhost:5432/openpiar_db

# ------------------------------------------------------------------------------
# SEGURIDAD — JWT
# Genera una clave segura con: openssl rand -hex 32
# ------------------------------------------------------------------------------
SECRET_KEY=cambia_esto_por_una_clave_secreta_muy_larga_y_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL — Google Gemini API
# Obtén tu clave en: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=


GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------------------------
APP_ENV=development
# En producción cambia a False para no exponer los docs de Swagger
SHOW_DOCS=True

# Orígenes permitidos para CORS (separados por coma)
# En desarrollo puedes usar * o http://localhost:5173 (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# SETUP WIZARD
# Se marca como True automáticamente tras completar el asistente de configuración.
# No edites manualmente: el backend lo gestiona en la tabla configuracion_sistema.
# ------------------------------------------------------------------------------
# (Este valor se persiste en DB, no en .env)
